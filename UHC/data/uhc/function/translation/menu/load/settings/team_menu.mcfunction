## FRA - Français / French
$execute if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.10 with minecraft:chest[minecraft:item_name=[{"text":"Joueurs par équipe > ","color":"#3FE7FF","italic":false},$(team_size_text)],minecraft:custom_data={Tags:"team_size"}] $(team_size_count)
$execute if score @s uhc.player.lang matches 061801 if score @s uhc.menu.settings.team matches 2 run item replace entity @s inventory.22 with minecraft:chest[minecraft:item_name=[{"text":"Joueurs par équipe > ","color":"#3FE7FF","italic":false},$(team_size_text)],minecraft:custom_data={Tags:"team_size"}] $(team_size_count)
execute if score #random_team uhc.data.setup matches 0 if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.11 with minecraft:light_blue_banner[minecraft:item_name=[{"text":"Format d'équipe","color":"#3FE7FF","italic":false}],minecraft:lore=[[{"text":"• ","color":"#3FE7FF","italic":false},{"text":"Équipe choisie","color":"#FFFFFF","italic":false}],[{"text":"• ","color":"#FF3F3F","italic":false},{"text":"Équipe aléatoire","color":"#9F9F9F","italic":true}]],minecraft:custom_data={Tags:"team_format"}]
execute if score #random_team uhc.data.setup matches 1 if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.11 with minecraft:light_blue_bundle[minecraft:item_name=[{"text":"Format d'équipe","color":"#3FE7FF","italic":false}],minecraft:lore=[[{"text":"• ","color":"#FF3F3F","italic":false},{"text":"Équipe choisie","color":"#9F9F9F","italic":true}],[{"text":"• ","color":"#3FE7FF","italic":false},{"text":"Équipe aléatoire","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:bundle_contents"]},minecraft:custom_data={Tags:"team_format"}]
execute if score #random_team uhc.data.setup matches 1.. unless score #team_size uhc.data.setup matches 2..3 if score @s[tag=uhc.host] uhc.player.lang matches 061801 run item replace entity @s inventory.12 with minecraft:black_bundle[minecraft:item_name=[{"text":"Nombre de pots","color":"#3FE7FF","italic":false}],minecraft:lore=[[{"text":"• ","color":"#3FE7FF","italic":false},{"text":"Un seul pot","color":"#FFFFFF","italic":false}],[{"text":"• ","color":"#FF3F3F","italic":false},{"text":"Nombre de pots = Joueurs par équipe","color":"#9F9F9F","italic":true}],[{"text":"Seulement en équipe de 2 ou 3.","color":"#9F9F9F","italic":true}]],minecraft:tooltip_display={"hidden_components":["minecraft:bundle_contents"]},minecraft:custom_data={Tags:"pots_number"}]
execute if score #random_team uhc.data.setup matches 1.. if score #team_size uhc.data.setup matches 2..3 if score #random_team_pots uhc.data.setup matches 1 if score @s[tag=uhc.host] uhc.player.lang matches 061801 run item replace entity @s inventory.12 with minecraft:yellow_bundle[minecraft:item_name=[{"text":"Nombre de pots","color":"#3FE7FF","italic":false}],minecraft:lore=[[{"text":"• ","color":"#3FE7FF","italic":false},{"text":"Un seul pot","color":"#FFFFFF","italic":false}],[{"text":"• ","color":"#FF3F3F","italic":false},{"text":"Nombre de pots = Joueurs par équipe","color":"#9F9F9F","italic":true}],[{"text":"Seulement en équipe de 2 ou 3.","color":"#9F9F9F","italic":true}]],minecraft:tooltip_display={"hidden_components":["minecraft:bundle_contents"]},minecraft:custom_data={Tags:"pots_number"}]
execute if score #random_team uhc.data.setup matches 1.. if score #random_team_pots uhc.data.setup matches 2.. if score @s[tag=uhc.host] uhc.player.lang matches 061801 run item replace entity @s inventory.12 with minecraft:yellow_bundle[minecraft:item_name=[{"text":"Nombre de pots","color":"#3FE7FF","italic":false}],minecraft:lore=[[{"text":"• ","color":"#FF3F3F","italic":false},{"text":"Un seul pot","color":"#9F9F9F","italic":true}],[{"text":"• ","color":"#3FE7FF","italic":false},{"text":"Nombre de pots = Joueurs par équipe","color":"#FFFFFF","italic":false}],[{"text":"Seulement en équipe de 2 ou 3.","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:bundle_contents"]},minecraft:custom_data={Tags:"pots_number"}]
execute if score #random_team uhc.data.setup matches 1.. if score @s[tag=uhc.host] uhc.player.lang matches 061801 run item replace entity @s inventory.13 with minecraft:white_bundle[minecraft:item_name=[{"text":"Création des équipes","color":"#3FE7FF","italic":false}],minecraft:tooltip_display={"hidden_components":["minecraft:bundle_contents"]},minecraft:custom_data={Tags:"random_team_instant"}]
execute if score #anonyme_team uhc.data.setup matches 0 if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.16 with minecraft:copper_chest[minecraft:item_name=[{"text":"Équipes anonymes","color":"#FF3F3F","italic":false}],minecraft:custom_data={Tags:"team_anonyme"}]
execute if score #anonyme_team uhc.data.setup matches 1 if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.16 with minecraft:ender_chest[minecraft:item_name=[{"text":"Équipes anonymes","color":"#3FE7FF","italic":false}],minecraft:custom_data={Tags:"team_anonyme"}]

