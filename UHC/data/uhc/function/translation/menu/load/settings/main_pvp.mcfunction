## FRA - Français / French
$execute if score @s uhc.player.lang matches 061801 if score @s uhc.menu.settings.pvp matches ..10 run item replace entity @s inventory.3 with minecraft:diamond_sword[minecraft:item_name=[{"text":"PvP","color":"#FF3F3F","italic":false}],minecraft:lore=[[{"text":"Période sans PvP > ","color":"#FFFFFF","italic":false},$(pvp),{"text":" minutes","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:attribute_modifiers"]},minecraft:custom_data={Tags:"settings_pvp"}]
$execute if score @s[tag=uhc.host] uhc.player.lang matches 061801 if score @s uhc.menu.settings.pvp matches 11.. run item replace entity @s inventory.19 with minecraft:diamond_sword[minecraft:item_name=[{"text":"PvP","color":"#FF3F3F","italic":false}],minecraft:lore=[[{"text":"Période sans PvP > ","color":"#FFFFFF","italic":false},$(pvp),{"text":" minutes","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:attribute_modifiers"]},minecraft:custom_data={Tags:"settings_pvp"}]
$execute if score @s[tag=!uhc.host] uhc.player.lang matches 061801 if score @s uhc.menu.settings.pvp matches 11.. run item replace entity @s inventory.24 with minecraft:diamond_sword[minecraft:item_name=[{"text":"PvP","color":"#FF3F3F","italic":false}],minecraft:lore=[[{"text":"Période sans PvP > ","color":"#FFFFFF","italic":false},$(pvp),{"text":" minutes","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:attribute_modifiers"]},minecraft:custom_data={Tags:"settings_pvp"}]
$execute if score @s[tag=uhc.host] uhc.player.lang matches 061801 if score @s uhc.menu.settings.pvp matches 01 run item replace entity @s inventory.22 with minecraft:clock[minecraft:item_name=[{"text":"PvP","color":"#FF3F3F","italic":false}],minecraft:lore=[[{"text":"Période sans PvP > ","color":"#FFFFFF","italic":false},$(pvp),{"text":" minutes","color":"#FFFFFF","italic":false}]],minecraft:tooltip_display={"hidden_components":["minecraft:attribute_modifiers"]},minecraft:custom_data={Tags:"settings_pvp"}]

