execute unless items entity @s inventory.17 * run item replace entity @s inventory.17 with minecraft:magenta_stained_glass_pane[minecraft:tooltip_display={"hide_tooltip":true}]
execute unless items entity @s inventory.18 * run item replace entity @s inventory.18 with minecraft:purple_stained_glass_pane[minecraft:tooltip_display={"hide_tooltip":true}]
