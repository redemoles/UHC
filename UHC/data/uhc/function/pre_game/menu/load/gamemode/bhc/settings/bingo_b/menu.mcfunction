## FRA - Français
$execute if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.10 with minecraft:light_blue_dye[minecraft:item_name=[{"text":"Départ > ","color":"#FFFFFF","bold":false,"italic":false},$(start),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:custom_data={Tags:"bhc_settings"}]
$execute if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.11 with minecraft:red_dye[minecraft:item_name=[{"text":"Fin > ","color":"#FFFFFF","bold":false,"italic":false},$(end),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:custom_data={Tags:"bhc_settings"}]
$execute if score #bhc bhc.scenario matches 1 if score @s uhc.menu.gamemode.bhc matches 16.. if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.12 with minecraft:gold_nugget[minecraft:item_name=[{"text":"Épuisement des ressources > ","color":"#FFFFFF","bold":false,"italic":false},$(exhaustion),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:lore=[[{"text":"Les cases complétées par un certain nombre d'équipe seront bloquées.","color":"#FFFFFF","bold":false,"italic":false}]],minecraft:custom_data={Tags:"bhc_settings"}]

$execute if score @s uhc.player.lang matches 061801 if score @s uhc.menu.gamemode.bhc matches 16 run item replace entity @s inventory.22 with minecraft:light_blue_dye[minecraft:item_name=[{"text":"Départ > ","color":"#FFFFFF","bold":false,"italic":false},$(start),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:custom_data={Tags:"bhc_settings"}]
$execute if score @s uhc.player.lang matches 061801 if score @s uhc.menu.gamemode.bhc matches 17 run item replace entity @s inventory.22 with minecraft:red_dye[minecraft:item_name=[{"text":"Fin > ","color":"#FFFFFF","bold":false,"italic":false},$(end),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:custom_data={Tags:"bhc_settings"}]
$execute if score #bhc bhc.scenario matches 1 if score @s uhc.menu.gamemode.bhc matches 18 if score @s uhc.player.lang matches 061801 run item replace entity @s inventory.22 with minecraft:gold_nugget[minecraft:item_name=[{"text":"Exhaustion of ressources > ","color":"#FFFFFF","bold":false,"italic":false},$(exhaustion),{"text":" minutes","color":"#FFFFFF","bold":false,"italic":false}],minecraft:lore=[[{"text":"Squares that have been completed by","color":"#FFFFFF","bold":false,"italic":false}],[{"text":"a certain number of teams will be locked.","color":"#FFFFFF","bold":false,"italic":false}]],minecraft:custom_data={Tags:"bhc_settings"}]

