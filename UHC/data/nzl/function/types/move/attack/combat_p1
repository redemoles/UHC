
#> nzl:types/move/attack/combat_p1
#
# @within			function tag "nzl:advancements/combat_attack_p1.json"
#
#
# @description		Dynamo-poing attaquant
#

# Fin de Dynamo-poing
scoreboard players operation #team uhc.id.team = @s uhc.id.team
scoreboard players set @e[type=marker,predicate=uhc:id_team] nzl.attack.length.02 0
advancement revoke @s only nzl:combat_attack_p1

# Trouille pour la victime
scoreboard players set #temp nzl.data 0
execute at @s positioned ^ ^ ^0.1 run function nzl:types/move/attack/combat_p2
scoreboard players set #temp nzl.data 0

execute if score @s nzl.type.level matches ..2 run effect give @p[tag=nzl.combat.victim] blindness 1 0 true
execute if score @s nzl.type.level matches 3 run effect give @p[tag=nzl.combat.victim] blindness 2 0 true
tag @a remove nzl.combat.victim
